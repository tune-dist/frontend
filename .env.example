# ---------------------------------------------------------------------------
# KratoLib Frontend - Environment Variables
# ---------------------------------------------------------------------------

# Web3Forms access key used by the contact form and newsletter signup during
# the soft launch (frontend-only release). Replace with your own key from
# https://web3forms.com once the account is rotated.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Backend API URL.
# NOTE: not used during the soft launch — backend-dependent routes
# (/auth, /dashboard, /checkout, /upload, /p, /test-connection) are gated
# behind /coming-soon via middleware. Keep this for when the backend goes
# live and the gate is removed.
NEXT_PUBLIC_API_URL=http://localhost:3001

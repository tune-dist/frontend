# =============================================================================
# Kratolib Frontend — copy to .env.local
# =============================================================================

# Backend API (must match backend PORT / BASE_URL)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Razorpay checkout (public key — must match backend RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Upload defaults (optional)
NEXT_PUBLIC_DEFAULT_LABEL=KratoLib
NEXT_PUBLIC_DEFAULT_ISRC=

# --- Next.js API routes (server-side only, optional legacy direct search routes) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# YOUTUBE_API_KEY=
# APPLE_DEVELOPER_TOKEN=

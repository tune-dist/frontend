# =============================================================================
# Kratolib Frontend — copy to .env.local
# Full reference: docs/ENV.md
# =============================================================================

# Backend API (must match backend PORT, e.g. http://localhost:3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Upload defaults (optional). Keep NEXT_PUBLIC_DEFAULT_LABEL in sync with backend DEFAULT_LABEL.
NEXT_PUBLIC_DEFAULT_LABEL=KratoLib
NEXT_PUBLIC_DEFAULT_ISRC=

# Google reCAPTCHA v3 (contact form — public site key)
# Must pair with backend RECAPTCHA_SECRET_KEY from the same key pair.
# Local Google test site key: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Production: create at https://www.google.com/recaptcha/admin and restart Next after changing.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Razorpay: no frontend env needed — checkout receives keyId from POST /payments/create-order

# MSG91 OTP Widget (phone verification at login — client-side tokenAuth is widget-scoped)
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
